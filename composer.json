{
    "name": "arthem/core-bundle",
    "description": "Templated mailer, session-aware logging and extra validation constraints for Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "monolog/monolog": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/mailer": "^6.4 || ^7.0 || ^8.0",
        "symfony/monolog-bundle": "^3.8 || ^4.0",
        "symfony/property-access": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "suggest": {
        "symfony/mailer": "To send templated emails with Arthem\\Bundle\\CoreBundle\\Mailer\\MailerInterface",
        "symfony/monolog-bundle": "To tag log records with the current session",
        "symfony/property-access": "To use the DateRange validation constraint",
        "symfony/twig-bundle": "To render email templates",
        "symfony/validator": "To use the Age, DateRange, Name and Validate constraints"
    },
    "autoload": {
        "psr-4": {
            "Arthem\\Bundle\\CoreBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arthem\\Bundle\\CoreBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "cs": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit 512M",
        "phpunit": "phpunit",
        "test": [
            "@cs-check",
            "@phpstan",
            "@phpunit"
        ]
    }
}
