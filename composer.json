{
    "name": "arthem/core-bundle",
    "description": "Core bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6",
        "symfony/security-bundle": "^6"
    },
    "require-dev": {
        "symfony/console": "^6",
        "symfony/form": "^6",
        "symfony/twig-bundle": "^6",
        "symfony/mailer": "^6",
        "symfony/validator": "^6",
        "symfony/monolog-bundle": "^3.8",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "cs": "vendor/bin/php-cs-fixer fix",
        "stan": "vendor/bin/php-cs-fixer fix",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit 512M Command DependencyInjection Logger Mailer Validator --level 2"
    },
    "autoload": {
        "psr-4": {
            "Arthem\\Bundle\\CoreBundle\\": ""
        }
    }
}
